{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:screen2run:human-ratings:1",
  "title": "Anonymized quantitative human ratings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "raters", "methods", "items", "records"],
  "properties": {
    "schema": {"const": "screen2run-human-ratings/1"},
    "raters": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6"]}},
    "methods": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["ours", "layoutcoder", "dcgen"]}},
    "items": {"type": "object", "additionalProperties": false, "required": ["v", "c"], "properties": {"v": {"$ref": "#/$defs/itemOrder"}, "c": {"$ref": "#/$defs/itemOrder"}}},
    "records": {"type": "array", "minItems": 2160, "maxItems": 2160, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "itemOrder": {"type": "array", "minItems": 60, "maxItems": 60, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "rank": {"type": "integer", "minimum": 1, "maximum": 3},
    "visualValues": {
      "type": "object", "additionalProperties": false,
      "required": ["overall", "layout", "text", "image", "style", "replace", "rank"],
      "properties": {"overall": {"$ref": "#/$defs/score"}, "layout": {"$ref": "#/$defs/score"}, "text": {"$ref": "#/$defs/score"}, "image": {"$ref": "#/$defs/score"}, "style": {"$ref": "#/$defs/score"}, "replace": {"type": "integer", "enum": [0, 1]}, "rank": {"$ref": "#/$defs/rank"}}
    },
    "codeValues": {
      "type": "object", "additionalProperties": false,
      "required": ["readability", "maintainability", "practice", "usability", "rank"],
      "properties": {"readability": {"$ref": "#/$defs/score"}, "maintainability": {"$ref": "#/$defs/score"}, "practice": {"$ref": "#/$defs/score"}, "usability": {"$ref": "#/$defs/score"}, "rank": {"$ref": "#/$defs/rank"}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["part", "rater", "item_id", "screen_id", "dataset", "method", "values", "collection_round"],
      "properties": {
        "part": {"enum": ["v", "c"]}, "rater": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6"]},
        "item_id": {"type": "string", "minLength": 1}, "screen_id": {"type": "string", "minLength": 1},
        "dataset": {"enum": ["Easy", "Real", "Unseen"]}, "method": {"enum": ["ours", "layoutcoder", "dcgen"]},
        "values": {"type": "object"}, "collection_round": {"enum": ["initial", "code_supplement"]}
      },
      "allOf": [
        {"if": {"properties": {"part": {"const": "v"}}}, "then": {"properties": {"values": {"$ref": "#/$defs/visualValues"}, "collection_round": {"const": "initial"}}}},
        {"if": {"properties": {"part": {"const": "c"}}}, "then": {"properties": {"values": {"$ref": "#/$defs/codeValues"}}}}
      ]
    }
  }
}
