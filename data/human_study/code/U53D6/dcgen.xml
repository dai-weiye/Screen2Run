<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="411.4239dp"
        android:layout_height="49.028dp"
        android:id="@+id/view_2"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:background="#000000"
            android:id="@+id/view_3"
            android:layout_width="215.9975dp"
            android:layout_height="49.028dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:text="LEGO Friends HD Gameplay music video"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/view_4"
            android:layout_width="74.3991dp"
            android:layout_height="49.028dp"
            android:layout_marginStart="337.0247dp"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/img"
                    android:scaleType="fitCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:scaleType="fitCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:src="@drawable/img"
                    android:scaleType="fitCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="1:06"
                    android:textColor="#E8E8E8"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:src="@drawable/img"
                android:layout_gravity="end"
                android:scaleType="fitCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:background="#000000"
        android:id="@+id/view_5"
        android:layout_width="411.4239dp"
        android:layout_height="248.5686dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="196.7978dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="❚❚"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.08"
            android:shadowColor="#66000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Tap to continue"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#66000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="411.4239dp"
        android:layout_height="30.1711dp"
        android:background="#000000"
        android:id="@+id/view_6"
        android:layout_marginStart="0dp"
        android:layout_marginTop="593.8218dp">

        <ImageView
            android:background="#000000"
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:id="@+id/view_7"
            android:layout_width="29.8282dp"
            android:layout_height="30.1711dp"
            android:layout_marginStart="381.5956dp"
            android:layout_marginTop="0dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:background="#000000"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:id="@+id/view_8"
            android:layout_width="379.8814dp"
            android:layout_height="30.1711dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp">

            <TextView
                android:text="0:26"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp" />

            <SeekBar
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4080"
                android:progress="26"
                android:progressTint="#FF0000"
                android:progressBackgroundTint="#808080"
                android:thumbTint="#FF0000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <TextView
                android:text="1:08:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="YouTube" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="411.4239dp"
        android:layout_height="29.8282dp"
        android:background="#FF000000"
        android:id="@+id/view_9"
        android:layout_marginStart="0dp"
        android:layout_marginTop="628.45dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:background="#FF000000"
            android:id="@+id/view_10"
            android:layout_width="39.771dp"
            android:layout_height="29.8282dp"
            android:layout_marginStart="274.2826dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:id="@+id/view_11"
            android:layout_width="41.1424dp"
            android:layout_height="29.8282dp"
            android:layout_marginStart="185.1407dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:background="#FF000000"
            android:id="@+id/view_12"
            android:layout_width="38.3996dp"
            android:layout_height="29.8282dp"
            android:layout_marginStart="98.7417dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>
</FrameLayout>
