<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="658.3dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_1"
        android:contentDescription="@null"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp" />

    <ImageView
        android:id="@+id/view_3"
        android:layout_width="84.2dp"
        android:layout_height="315.3dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_2"
        android:contentDescription="@null"
        android:layout_gravity="top|start"
        android:layout_marginStart="286.9dp"
        android:layout_marginLeft="286.9dp"
        android:layout_marginTop="151.6dp" />

    <ImageView
        android:id="@+id/view_4"
        android:layout_width="22.6dp"
        android:layout_height="142.4dp"
        android:src="@drawable/img_3"
        android:contentDescription="FOR PARENTS"
        android:layout_gravity="top|start"
        android:layout_marginStart="376.8dp"
        android:layout_marginLeft="376.8dp"
        android:layout_marginTop="0.0dp"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/view_5"
        android:layout_width="36.2dp"
        android:layout_height="35.8dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="371.0dp"
        android:layout_marginLeft="371.0dp"
        android:layout_marginTop="595.8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/view_6"
            android:layout_width="28.2dp"
            android:layout_height="27.9dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_4"
            android:contentDescription="@null"
            android:layout_gravity="top|start"
            android:layout_marginStart="3.8dp"
            android:layout_marginLeft="3.8dp"
            android:layout_marginTop="3.8dp" />
    </FrameLayout>
</FrameLayout>
