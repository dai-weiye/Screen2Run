<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFB340"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="658.3dp"
        android:background="#FBB040"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/view_3"
            android:layout_width="246.9dp"
            android:layout_height="231.1dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_1"
            android:layout_gravity="top|start"
            android:layout_marginStart="82.3dp"
            android:layout_marginLeft="82.3dp"
            android:layout_marginTop="151.9dp" />

        <TextView
            android:id="@+id/view_4"
            android:layout_width="147.6dp"
            android:layout_height="13.0dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical|center_horizontal"
            android:text="SAVE TIME &amp; JUMP THE LINE!"
            android:textColor="#000000"
            android:textSize="10.5sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="133.5dp"
            android:layout_marginLeft="133.5dp"
            android:layout_marginTop="445.6dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5.8sp"
            android:autoSizeMaxTextSize="10.5sp"
            android:autoSizeStepGranularity="1px" />

        <TextView
            android:id="@+id/view_5"
            android:layout_width="357.6dp"
            android:layout_height="15.3dp"
            android:gravity="center_vertical|center_horizontal"
            android:text="Use the app to order in a snap. Meals customized just for you."
            android:textColor="#000000"
            android:textSize="12.5sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="32.3dp"
            android:layout_marginLeft="32.3dp"
            android:layout_marginTop="469.9dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6.9sp"
            android:autoSizeMaxTextSize="12.5sp"
            android:autoSizeStepGranularity="1px" />

        <FrameLayout
            android:id="@+id/view_6"
            android:layout_width="28.7dp"
            android:layout_height="3.3dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="192.1dp"
            android:layout_marginLeft="192.1dp"
            android:layout_marginTop="577.6dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/view_7"
                android:layout_width="4.2dp"
                android:layout_height="3.3dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_2"
                android:layout_gravity="top|start"
                android:layout_marginStart="0.0dp"
                android:layout_marginLeft="0.0dp"
                android:layout_marginTop="0.0dp" />

            <ImageView
                android:id="@+id/view_8"
                android:layout_width="4.2dp"
                android:layout_height="3.3dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_3"
                android:layout_gravity="top|start"
                android:layout_marginStart="12.2dp"
                android:layout_marginLeft="12.2dp"
                android:layout_marginTop="0.0dp" />

            <ImageView
                android:id="@+id/view_9"
                android:layout_width="4.2dp"
                android:layout_height="3.3dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_4"
                android:layout_gravity="top|start"
                android:layout_marginStart="24.5dp"
                android:layout_marginLeft="24.5dp"
                android:layout_marginTop="0.0dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="31.9dp"
            android:layout_height="16.8dp"
            android:background="#FFFFFF"
            android:id="@+id/view_10"
            android:layout_gravity="top|start"
            android:layout_marginStart="370.3dp"
            android:layout_marginLeft="370.3dp"
            android:layout_marginTop="600.7dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <Button
                android:id="@+id/view_11"
                android:layout_width="31.9dp"
                android:layout_height="16.8dp"
                android:background="#FBB040"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Skip"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11.1sp"
                android:gravity="center"
                android:layout_gravity="top|start"
                android:layout_marginStart="0.0dp"
                android:layout_marginLeft="0.0dp"
                android:layout_marginTop="0.0dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6.1sp"
                android:autoSizeMaxTextSize="11.1sp"
                android:autoSizeStepGranularity="1px"
                android:padding="0dp" />
        </FrameLayout>
    </FrameLayout>

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="17.1dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#000000" />

    <View
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="32.9dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="625.4dp"
        android:background="#000000" />
</FrameLayout>
