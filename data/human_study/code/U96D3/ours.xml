<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="658.3dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="411.4dp"
            android:layout_height="8.0dp"
            android:id="@+id/view_3"
            android:layout_gravity="top|start"
            android:layout_marginStart="0.0dp"
            android:layout_marginLeft="0.0dp"
            android:layout_marginTop="284.2dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/view_4"
                android:layout_width="3.0dp"
                android:layout_height="3.0dp"
                android:background="#FF333333"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/img_1"
                android:layout_gravity="top|start"
                android:layout_marginStart="152.0dp"
                android:layout_marginLeft="152.0dp"
                android:layout_marginTop="2.3dp" />

            <ImageView
                android:id="@+id/view_5"
                android:layout_width="8.0dp"
                android:layout_height="8.0dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/img_2"
                android:layout_gravity="top|start"
                android:layout_marginStart="201.5dp"
                android:layout_marginLeft="201.5dp"
                android:layout_marginTop="0.0dp" />

            <ImageView
                android:id="@+id/view_6"
                android:layout_width="3.0dp"
                android:layout_height="3.0dp"
                android:background="#FF333333"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/img_3"
                android:layout_gravity="top|start"
                android:layout_marginStart="256.4dp"
                android:layout_marginLeft="256.4dp"
                android:layout_marginTop="2.3dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="411.4dp"
            android:layout_height="4.2dp"
            android:id="@+id/view_7"
            android:layout_gravity="top|start"
            android:layout_marginStart="0.0dp"
            android:layout_marginLeft="0.0dp"
            android:layout_marginTop="646.1dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </FrameLayout>

    <View
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="35.3dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="623.0dp"
        android:background="#000000" />
</FrameLayout>
