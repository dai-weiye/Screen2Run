<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/view_2"
        android:layout_width="101.7dp"
        android:layout_height="182.9dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="154.3dp"
        android:layout_marginLeft="154.3dp"
        android:layout_marginTop="73.1dp" />

    <ImageView
        android:id="@+id/view_3"
        android:layout_width="149.0dp"
        android:layout_height="31.0dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_2"
        android:layout_gravity="top|start"
        android:layout_marginStart="131.0dp"
        android:layout_marginLeft="131.0dp"
        android:layout_marginTop="773.3dp" />

    <TextView
        android:id="@+id/view_4"
        android:text="GAIA GROUP"
        android:textColor="#3F3F3F"
        android:layout_width="111.3dp"
        android:layout_height="22.2dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="170.9dp"
        android:layout_marginLeft="170.9dp"
        android:layout_marginTop="620.3dp"
        android:textSize="18.3sp"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10.1sp"
        android:autoSizeMaxTextSize="18.3sp"
        android:autoSizeStepGranularity="1px"
        android:gravity="center_vertical|start" />

    <ImageView
        android:id="@+id/view_5"
        android:src="@drawable/img_3"
        android:layout_width="17.1dp"
        android:layout_height="18.3dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="92.2dp"
        android:layout_marginLeft="92.2dp"
        android:layout_marginTop="694.9dp"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/view_6"
        android:src="@drawable/img_4"
        android:layout_width="16.0dp"
        android:layout_height="17.5dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="197.3dp"
        android:layout_marginLeft="197.3dp"
        android:layout_marginTop="695.2dp"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/view_7"
        android:src="@drawable/img_5"
        android:layout_width="18.7dp"
        android:layout_height="17.9dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="298.7dp"
        android:layout_marginLeft="298.7dp"
        android:layout_marginTop="695.2dp"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="27.4dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#999999" />

    <View
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="48.0dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="843.4dp"
        android:background="#000000" />
</FrameLayout>
