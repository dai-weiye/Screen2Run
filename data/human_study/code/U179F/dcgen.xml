<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="411.4286dp"
    android:layout_height="891.4286dp"
    android:background="#FFFFFF"
    android:id="@+id/view_1">

    <RelativeLayout
        android:background="#808080"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:id="@+id/view_2"
        android:layout_width="411.4286dp"
        android:layout_height="27.0476dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:10"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/icon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img"
            android:tint="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_toEndOf="@id/time"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/icon2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img"
            android:tint="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_toEndOf="@id/icon1"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/icon3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img"
            android:tint="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_toEndOf="@id/icon2"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/icon4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img"
            android:tint="#FFFFFF"
            android:paddingStart="12dp"
            android:layout_toEndOf="@id/icon3"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img"
            android:tint="#FFFFFF"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <ImageView
        android:src="@drawable/img"
        android:scaleType="fitCenter"
        android:id="@+id/view_3"
        android:layout_width="411.4286dp"
        android:layout_height="195.0476dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="68.5714dp" />

    <ImageView
        android:src="@drawable/img"
        android:scaleType="centerInside"
        android:contentDescription="GAIA GROUP logo"
        android:id="@+id/view_4"
        android:layout_width="411.4286dp"
        android:layout_height="48dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="598.4762dp" />

    <View
        android:background="#000000"
        android:id="@+id/view_5"
        android:layout_width="411.4286dp"
        android:layout_height="19.4286dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="666.6667dp" />

    <FrameLayout
        android:layout_width="411.4286dp"
        android:layout_height="35.8095dp"
        android:background="#FF000000"
        android:id="@+id/view_6"
        android:layout_marginStart="0dp"
        android:layout_marginTop="686.0952dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:importantForAccessibility="no"
            android:id="@+id/view_7"
            android:layout_width="36.5714dp"
            android:layout_height="35.8095dp"
            android:layout_marginStart="290.2857dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:background="#FF000000"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:id="@+id/view_8"
            android:layout_width="35.0476dp"
            android:layout_height="35.8095dp"
            android:layout_marginStart="188.1905dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:contentDescription="Play"
            android:id="@+id/view_9"
            android:layout_width="34.6667dp"
            android:layout_height="35.8095dp"
            android:layout_marginStart="84.5714dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>
</FrameLayout>
