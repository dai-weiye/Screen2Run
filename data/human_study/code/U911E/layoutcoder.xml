<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="664">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="44"
                android:background="#8A8A86" />

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#ADADA8" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="56"
                android:background="#3E362C" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="127">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Remember photo locations?"
                android:textColor="#4FC3F7"
                android:textSize="20sp"
                android:fontFamily="sans-serif" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="365">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FF303030">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tag your photos and videos with the locations where they are taken."
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.15" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="18dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other apps can access this information along with your saved images."
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.15" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF4A4A4A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="No thanks"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#FF4A4A4A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Yes"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="153">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="#FF4A423C">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="47"
                android:background="#FF4E4E4E" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FF1C1815" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="52"
                android:background="#FF4A423C" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="210">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#474747">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.05"
                    android:background="#4A4A4A" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.95"
                    android:background="#918A82">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img"
                        android:scaleType="fitXY"
                        android:alpha="0.55" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:rotation="-8"
                        android:background="#2A2A2E" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/img"
                        android:scaleType="fitXY"
                        android:tint="#1E1E22" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="282">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="155">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF3B4249">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="104dp"
                    android:src="@drawable/img"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="92dp"
                    android:layout_marginBottom="118dp"
                    android:src="@drawable/img"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="192">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#141414">

                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center_vertical|left"
                    android:translationX="-90dp"
                    android:translationY="-18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:tint="#262626" />

                <ImageView
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center_vertical|left"
                    android:translationX="38dp"
                    android:translationY="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:tint="#17708E" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical|right"
                    android:layout_marginEnd="95dp"
                    android:translationY="-24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:tint="#606060" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|right"
                    android:layout_marginEnd="30dp"
                    android:translationY="22dp"
                    android:rotation="-12"
                    android:text="TOSHIBA"
                    android:textColor="#4A4A4A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="53">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0A0A0C">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="96dp"
                    android:layout_marginBottom="0dp"
                    android:background="#FF2A4C7A" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="94">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="#FF000000"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img"
                android:scaleType="centerInside"
                android:tint="#FFB0B0B0"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:contentDescription="" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img"
                android:scaleType="centerInside"
                android:tint="#FFB0B0B0"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:contentDescription="" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/img"
                android:scaleType="centerInside"
                android:tint="#FFB0B0B0"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:contentDescription="" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
