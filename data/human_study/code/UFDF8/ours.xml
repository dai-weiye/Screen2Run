<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="658.3dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/img_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp" />

    <ImageView
        android:id="@+id/view_3"
        android:layout_width="270.9dp"
        android:layout_height="178.0dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/img_2"
        android:layout_gravity="top|start"
        android:layout_marginStart="69.0dp"
        android:layout_marginLeft="69.0dp"
        android:layout_marginTop="98.9dp" />

    <View
        android:layout_width="28.6dp"
        android:layout_height="32.1dp"
        android:background="#63B0E9"
        android:id="@+id/view_4"
        android:layout_gravity="top|start"
        android:layout_marginStart="210.0dp"
        android:layout_marginLeft="210.0dp"
        android:layout_marginTop="13.5dp" />

    <FrameLayout
        android:id="@+id/view_5"
        android:layout_width="242.7dp"
        android:layout_height="54.2dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="84.0dp"
        android:layout_marginLeft="84.0dp"
        android:layout_marginTop="12.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/view_6"
            android:layout_width="218.2dp"
            android:layout_height="13.4dp"
            android:fontFamily="Roboto"
            android:text="Swipe down from the top to exit full screen."
            android:textColor="#325875"
            android:textSize="10.8sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9.4dp"
            android:layout_marginLeft="9.4dp"
            android:layout_marginTop="24.4dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5.9sp"
            android:autoSizeMaxTextSize="10.8sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />
    </FrameLayout>

    <Button
        android:id="@+id/view_7"
        android:layout_width="104.2dp"
        android:layout_height="28.5dp"
        android:background="@drawable/shape_1"
        android:fontFamily="Roboto"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="OK"
        android:textColor="#F3F3F3"
        android:textSize="12.3sp"
        android:backgroundTint="@null"
        android:layout_gravity="top|start"
        android:layout_marginStart="220.5dp"
        android:layout_marginLeft="220.5dp"
        android:layout_marginTop="81.9dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="6.8sp"
        android:autoSizeMaxTextSize="12.3sp"
        android:autoSizeStepGranularity="1px"
        android:padding="0dp"
        android:stateListAnimator="@null" />

    <ImageButton
        android:id="@+id/view_8"
        android:layout_width="168.0dp"
        android:layout_height="87.4dp"
        android:background="#1A7F9D"
        android:contentDescription="Play"
        android:scaleType="fitXY"
        android:src="@drawable/img_3"
        android:layout_gravity="top|start"
        android:layout_marginStart="120.0dp"
        android:layout_marginLeft="120.0dp"
        android:layout_marginTop="364.8dp" />

    <Button
        android:id="@+id/view_9"
        android:layout_width="69.0dp"
        android:layout_height="43.1dp"
        android:background="@drawable/img_4"
        android:fontFamily="Roboto"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="R"
        android:textColor="#671C77"
        android:textSize="33.4sp"
        android:textStyle="bold"
        android:backgroundTint="@null"
        android:layout_gravity="top|start"
        android:layout_marginStart="90.2dp"
        android:layout_marginLeft="90.2dp"
        android:layout_marginTop="480.9dp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18.4sp"
        android:autoSizeMaxTextSize="33.4sp"
        android:autoSizeStepGranularity="1px"
        android:padding="0dp"
        android:stateListAnimator="@null" />

    <ImageButton
        android:id="@+id/view_10"
        android:layout_width="68.2dp"
        android:layout_height="43.1dp"
        android:background="#3C8535"
        android:contentDescription="Music"
        android:scaleType="fitXY"
        android:src="@drawable/img_5"
        android:layout_gravity="top|start"
        android:layout_marginStart="171.2dp"
        android:layout_marginLeft="171.2dp"
        android:layout_marginTop="478.9dp" />

    <ImageButton
        android:id="@+id/view_11"
        android:layout_width="68.2dp"
        android:layout_height="43.1dp"
        android:background="#3C8535"
        android:contentDescription="Sound"
        android:scaleType="fitXY"
        android:src="@drawable/img_6"
        android:layout_gravity="top|start"
        android:layout_marginStart="251.2dp"
        android:layout_marginLeft="251.2dp"
        android:layout_marginTop="478.9dp" />

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="18.5dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#3A5E7E" />
</FrameLayout>
