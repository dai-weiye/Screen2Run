<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp"
    android:id="@+id/view_1">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4239dp"
        android:layout_height="363.7673dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerInside"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="PHOTO COLLAGE"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.28"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <FrameLayout
        android:background="#0D0D0D"
        android:id="@+id/view_3"
        android:layout_width="411.4239dp"
        android:layout_height="64.4564dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="515.6512dp">

        <ImageView
            android:layout_gravity="center"
            android:src="@drawable/img"
            android:contentDescription="Next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/view_4"
        android:layout_width="411.4239dp"
        android:layout_height="32.9139dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="625.3643dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerInside"
            android:background="#000000"
            android:id="@+id/view_5"
            android:layout_width="39.771dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="274.2826dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:background="#FF000000"
            android:contentDescription=""
            android:id="@+id/view_6"
            android:layout_width="41.1424dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="185.1407dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:background="#FF000000"
            android:contentDescription="Back"
            android:id="@+id/view_7"
            android:layout_width="38.3996dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="98.7417dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>
</FrameLayout>
