        android:textSize="20sp"
        android:lineSpacingMultiplier="1.2"
        android:id="@+id/view_5"
        android:layout_width="411.4239dp"
        android:layout_height="36.6853dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="321.2535dp" />

    <TextView
        android:text="You'll still be covered because we'll ask for codes when you (or anyone else) tries to sign in to your account from other computers."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:background="#4285F4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:id="@+id/view_6"
        android:layout_width="411.4239dp"
        android:layout_height="38.0567dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="361.7102dp" />

