            android:layout_width="32.2282dp"
            android:layout_height="21.9426dp"
            android:layout_marginStart="379.1957dp"
            android:layout_marginTop="0dp" />

        <LinearLayout
            android:background="#3B7DF6"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_9"
            android:layout_width="48.6852dp"
            android:layout_height="21.9426dp"
            android:layout_marginStart="181.3694dp"
            android:layout_marginTop="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img"
                android:tint="#80FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img"
                android:tint="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img"
                android:tint="#80FFFFFF" />
        </LinearLayout>

        <TextView
