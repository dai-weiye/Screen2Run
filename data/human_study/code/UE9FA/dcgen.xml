<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="411.4286dp"
    android:layout_height="731.4286dp"
    android:id="@+id/view_1">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4286dp"
        android:layout_height="27.0476dp"
        android:background="#0E2A38"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0E2A38"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:id="@+id/view_3"
            android:layout_width="72.381dp"
            android:layout_height="27.0476dp"
            android:layout_marginStart="339.0476dp"
            android:layout_marginTop="0dp">

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:layout_marginStart="10dp"
                android:tint="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:layout_marginStart="10dp"
                android:tint="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0D2B3B"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:id="@+id/view_4"
            android:layout_width="101.7143dp"
            android:layout_height="27.0476dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp">

            <TextView
                android:text="9:25"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.35" />

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:src="@drawable/img"
        android:scaleType="fitXY"
        android:id="@+id/view_5"
        android:layout_width="411.4286dp"
        android:layout_height="83.0476dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="123.4286dp" />

    <LinearLayout
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:id="@+id/view_6"
        android:layout_width="411.4286dp"
        android:layout_height="177.5238dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="225.1429dp">

        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="Join Class"
                android:textColor="#000000"
                android:textSize="32sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Enter link to join class"
                android:textColor="#000000"
                android:textSize="18sp"
                android:paddingTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:background="#E0E0E0"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="link"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="dummy_user_input"
                android:textColor="#000000"
                android:textSize="18sp"
                android:paddingTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:background="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:id="@+id/view_7"
        android:layout_width="411.4286dp"
        android:layout_height="76.1905dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="402.6667dp">

        <TextView
            android:text="CANCEL"
            android:textColor="#00A9E0"
            android:textSize="16sp"
            android:textStyle="normal"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="JOIN"
            android:textColor="#00A9E0"
            android:textSize="16sp"
            android:textStyle="normal"
            android:letterSpacing="0.05"
            android:paddingStart="32dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:text="JOIN WITH LINK"
        android:textColor="#1B6478"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="#00000000"
        android:id="@+id/view_8"
        android:layout_width="411.4286dp"
        android:layout_height="27.8095dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="523.8095dp" />

    <TextView
        android:text="Have a meeting link? Simply enter the class without signing in."
        android:textColor="#1F1F1F"
        android:textSize="16sp"
        android:gravity="center_horizontal"
        android:background="#8A8A8A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fontFamily="sans-serif"
        android:id="@+id/view_9"
        android:layout_width="411.4286dp"
        android:layout_height="48.381dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="579.8095dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:background="#FF000000"
        android:gravity="center"
        android:id="@+id/view_10"
        android:layout_width="411.4286dp"
        android:layout_height="55.2381dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="676.1905dp">

        <TextView
            android:text="▼"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="●"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="■"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
