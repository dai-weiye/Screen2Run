<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#666666"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="731.4dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/view_3"
            android:layout_width="81.9dp"
            android:layout_height="106.7dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_1"
            android:layout_gravity="top|start"
            android:layout_marginStart="164.2dp"
            android:layout_marginLeft="164.2dp"
            android:layout_marginTop="99.8dp" />

        <FrameLayout
            android:id="@+id/view_4"
            android:layout_width="389.3dp"
            android:layout_height="234.3dp"
            android:background="@drawable/shape_2"
            android:elevation="4dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="10.3dp"
            android:layout_marginLeft="10.3dp"
            android:layout_marginTop="234.7dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/view_5"
                android:layout_width="111.3dp"
                android:layout_height="27.2dp"
                android:text="Join Class"
                android:textColor="#000000"
                android:textSize="22.6sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="43.8dp"
                android:layout_marginLeft="43.8dp"
                android:layout_marginTop="24.4dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12.4sp"
                android:autoSizeMaxTextSize="22.6sp"
                android:autoSizeStepGranularity="1px"
                android:gravity="center_vertical|start" />

            <TextView
                android:id="@+id/view_6"
                android:layout_width="183.8dp"
                android:layout_height="21.9dp"
                android:text="Enter link to join class"
                android:textColor="#212121"
                android:textSize="18.0sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="45.2dp"
                android:layout_marginLeft="45.2dp"
                android:layout_marginTop="52.7dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9.9sp"
                android:autoSizeMaxTextSize="18.0sp"
                android:autoSizeStepGranularity="1px"
                android:gravity="center_vertical|start" />

            <FrameLayout
                android:id="@+id/view_7"
                android:layout_width="330.9dp"
                android:layout_height="62.2dp"
                android:background="@drawable/shape_3"
                android:layout_gravity="top|start"
                android:layout_marginStart="0.0dp"
                android:layout_marginLeft="0.0dp"
                android:layout_marginTop="104.6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/view_8"
                    android:layout_width="24.5dp"
                    android:layout_height="17.1dp"
                    android:text="link"
                    android:textColor="#00ADE9"
                    android:textSize="13.9sp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="35.9dp"
                    android:layout_marginLeft="35.9dp"
                    android:layout_marginTop="12.8dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7.7sp"
                    android:autoSizeMaxTextSize="13.9sp"
                    android:autoSizeStepGranularity="1px"
                    android:gravity="center_vertical|start" />

                <EditText
                    android:id="@+id/view_9"
                    android:layout_width="331.8dp"
                    android:layout_height="62.2dp"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:inputType="text"
                    android:text="dummy_user_input"
                    android:textColor="#212121"
                    android:textSize="17.9sp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="36.6dp"
                    android:layout_marginLeft="36.6dp"
                    android:layout_marginTop="13.1dp"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9.8sp"
                    android:autoSizeMaxTextSize="17.9sp"
                    android:autoSizeStepGranularity="1px"
                    android:paddingStart="0.0dp"
                    android:paddingLeft="0.0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingEnd="0dp" />

                <View
                    android:layout_width="354.3dp"
                    android:layout_height="2.3dp"
                    android:background="#00A0C6"
                    android:id="@+id/view_10"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="17.9dp"
                    android:layout_marginLeft="17.9dp"
                    android:layout_marginTop="63.4dp" />
            </FrameLayout>

            <Button
                android:id="@+id/view_11"
                android:layout_width="63.7dp"
                android:layout_height="24.3dp"
                android:background="#FEFEFF"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="CANCEL"
                android:textColor="#00ADE9"
                android:textSize="17.9sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="210.0dp"
                android:layout_marginLeft="210.0dp"
                android:layout_marginTop="190.5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9.8sp"
                android:autoSizeMaxTextSize="17.9sp"
                android:autoSizeStepGranularity="1px"
                android:padding="0dp" />

            <Button
                android:id="@+id/view_12"
                android:layout_width="38.7dp"
                android:layout_height="24.3dp"
                android:background="#FEFEFF"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="JOIN"
                android:textColor="#00ADE9"
                android:textSize="17.4sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="302.5dp"
                android:layout_marginLeft="302.5dp"
                android:layout_marginTop="190.5dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9.6sp"
                android:autoSizeMaxTextSize="17.4sp"
                android:autoSizeStepGranularity="1px"
                android:padding="0dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="163.7dp"
            android:layout_height="36.2dp"
            android:background="#656565"
            android:id="@+id/view_13"
            android:layout_gravity="top|start"
            android:layout_marginStart="102.3dp"
            android:layout_marginLeft="102.3dp"
            android:layout_marginTop="513.5dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <Button
                android:id="@+id/view_14"
                android:layout_width="161.6dp"
                android:layout_height="34.1dp"
                android:background="#656565"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="JOIN WITH LINK"
                android:textColor="#00455D"
                android:textSize="18.6sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="22.6dp"
                android:layout_marginLeft="22.6dp"
                android:layout_marginTop="7.0dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10.2sp"
                android:autoSizeMaxTextSize="18.6sp"
                android:autoSizeStepGranularity="1px"
                android:padding="0dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/view_15"
            android:layout_width="382.6dp"
            android:layout_height="42.9dp"
            android:gravity="top|center_horizontal"
            android:text="Have a meeting link? Simply enter the class without signing in."
            android:textColor="#000000"
            android:textSize="15.6sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="23.6dp"
            android:layout_marginLeft="23.6dp"
            android:layout_marginTop="584.7dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:lineSpacingExtra="1.2dp" />
    </FrameLayout>

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="27.4dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#003249" />

    <View
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="54.9dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="676.6dp"
        android:background="#000000" />
</FrameLayout>
