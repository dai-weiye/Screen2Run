<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#65310F"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/view_2"
        android:layout_width="195.8dp"
        android:layout_height="85.4dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="17.8dp"
        android:layout_marginLeft="17.8dp"
        android:layout_marginTop="37.4dp" />

    <ImageView
        android:id="@+id/view_3"
        android:layout_width="1.0dp"
        android:layout_height="33.3dp"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="fitXY"
        android:src="@drawable/img_2"
        android:layout_gravity="top|start"
        android:layout_marginStart="410.5dp"
        android:layout_marginLeft="410.5dp"
        android:layout_marginTop="19.8dp" />

    <FrameLayout
        android:id="@+id/view_4"
        android:layout_width="246.5dp"
        android:layout_height="153.9dp"
        android:background="@drawable/img_3"
        android:layout_gravity="top|start"
        android:layout_marginStart="87.9dp"
        android:layout_marginLeft="87.9dp"
        android:layout_marginTop="212.1dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/view_5"
            android:layout_width="185.6dp"
            android:layout_height="24.3dp"
            android:fontFamily="sans-serif"
            android:text="Create New Collage"
            android:textColor="#666666"
            android:textSize="20.1sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="7.5dp"
            android:layout_marginLeft="7.5dp"
            android:layout_marginTop="13.6dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11.1sp"
            android:autoSizeMaxTextSize="20.1sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />

        <View
            android:layout_width="231.7dp"
            android:layout_height="1.1dp"
            android:background="#D0D0D0"
