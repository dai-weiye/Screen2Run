<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp"
    android:id="@+id/view_1">

    <FrameLayout
        android:layout_width="411.4239dp"
        android:layout_height="56.2279dp"
        android:background="#7B3E10"
        android:id="@+id/view_2"
        android:layout_marginStart="0dp"
        android:layout_marginTop="30.5139dp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#7B3E10"
            android:paddingTop="4dp"
            android:id="@+id/view_3"
            android:layout_width="25.714dp"
            android:layout_height="56.2279dp"
            android:layout_marginStart="385.7099dp"
            android:layout_marginTop="0dp">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#16110C" />

            <View
                android:layout_width="14dp"
                android:layout_height="5dp" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#16110C" />
        </LinearLayout>

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:contentDescription="PHOTO"
            android:id="@+id/view_4"
            android:layout_width="220.1118dp"
            android:layout_height="56.2279dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>

    <TextView
        android:background="#7B3611"
        android:text="COMICS"
        android:textColor="#1B1613"
        android:textSize="30sp"
        android:textStyle="bold|italic"
        android:fontFamily="sans-serif-black"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:id="@+id/view_5"
        android:layout_width="411.4239dp"
        android:layout_height="39.771dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="87.7704dp" />

    <LinearLayout
        android:orientation="vertical"
        android:background="#B85C1E"
        android:gravity="center_horizontal"
        android:id="@+id/view_6"
        android:layout_width="411.4239dp"
        android:layout_height="249.5971dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="221.4832dp">

        <LinearLayout
            android:orientation="vertical"
            android:background="#7B2D0E"
            android:gravity="center_horizontal"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="Create New Collage"
                android:textColor="#B0B0B0"
                android:textSize="48sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:background="#B0B0B0"
                android:minHeight="1dp"
                android:text=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:background="#3A3A3A"
            android:gravity="center_horizontal"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="Buy Stickers"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:background="#555555"
                android:minHeight="1dp"
                android:text=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:background="#555555"
                    android:minWidth="1dp"
                    android:text=""
                    android:minHeight="48dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Buy"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:background="#6B2A3A"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="+"
                android:textColor="#B0B0B0"
                android:textSize="24sp"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Get More Stickers"
                android:textColor="#B0B0B0"
                android:textSize="40sp"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:background="#2A2A2A"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/img"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Bring zombie apocalypse into your photos"
                    android:textColor="#B0B0B0"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Install Zombie Comics"
                        android:textColor="#808080"
                        android:textSize="18sp"
                        android:padding="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="›"
                        android:textColor="#808080"
                        android:textSize="18sp"
                        android:padding="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/view_7"
        android:layout_width="411.4239dp"
        android:layout_height="32.9139dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="625.3643dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:background="#000000"
            android:id="@+id/view_8"
            android:layout_width="39.771dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="274.2826dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:id="@+id/view_9"
            android:layout_width="41.1424dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="185.1407dp"
            android:layout_marginTop="0dp" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:contentDescription="Return"
            android:id="@+id/view_10"
            android:layout_width="38.3996dp"
            android:layout_height="32.9139dp"
            android:layout_marginStart="98.7417dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>
</FrameLayout>
