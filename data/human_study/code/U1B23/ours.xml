<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="731.4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/img_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp" />

    <FrameLayout
        android:id="@+id/view_3"
        android:layout_width="416.2dp"
        android:layout_height="731.4dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/view_4"
            android:layout_width="299.5dp"
            android:layout_height="86.4dp"
            android:src="@drawable/img_2"
            android:contentDescription="MEGASTORES\nDEN HAAG"
            android:layout_gravity="top|start"
            android:layout_marginStart="56.0dp"
            android:layout_marginLeft="56.0dp"
            android:layout_marginTop="95.3dp"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/view_5"
            android:layout_width="38.3dp"
            android:layout_height="17.3dp"
            android:fontFamily="sans-serif"
            android:text="Email"
            android:textColor="#FFFFFF"
            android:textSize="14.1sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="40.4dp"
            android:layout_marginLeft="40.4dp"
            android:layout_marginTop="243.6dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7.8sp"
            android:autoSizeMaxTextSize="14.1sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />

        <EditText
            android:id="@+id/view_6"
            android:layout_width="362.1dp"
            android:layout_height="39.7dp"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:inputType="textEmailAddress"
            android:text="dummy_user_input"
            android:textColor="#3E4444"
            android:textSize="22.1sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="39.2dp"
            android:layout_marginLeft="39.2dp"
            android:layout_marginTop="261.3dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12.1sp"
            android:autoSizeMaxTextSize="22.1sp"
            android:autoSizeStepGranularity="1px"
            android:paddingStart="0.0dp"
            android:paddingLeft="0.0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingEnd="0dp"
            android:gravity="center_vertical|start" />

        <View
            android:id="@+id/email_underline"
            android:layout_width="344.7dp"
            android:layout_height="2.1dp"
            android:background="#FFFFFF"
            android:layout_gravity="top|start"
            android:layout_marginStart="44.0dp"
            android:layout_marginLeft="44.0dp"
            android:layout_marginTop="296.7dp" />

        <FrameLayout
            android:id="@+id/view_7"
            android:layout_width="346.7dp"
            android:layout_height="39.1dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="41.9dp"
            android:layout_marginLeft="41.9dp"
            android:layout_marginTop="329.9dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <EditText
                android:id="@+id/view_8"
                android:layout_width="325.9dp"
                android:layout_height="37.7dp"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:inputType="text"
                android:text="Password"
                android:textColor="#3B270C"
                android:textSize="20.8sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="0.0dp"
                android:layout_marginLeft="0.0dp"
                android:layout_marginTop="0.0dp"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11.4sp"
                android:autoSizeMaxTextSize="20.8sp"
                android:autoSizeStepGranularity="1px"
                android:paddingStart="0.0dp"
                android:paddingLeft="0.0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical|start" />

            <ImageView
                android:id="@+id/view_9"
                android:layout_width="25.2dp"
                android:layout_height="21.5dp"
                android:contentDescription="@null"
                android:src="@drawable/img_3"
                android:layout_gravity="top|start"
                android:layout_marginStart="313.3dp"
                android:layout_marginLeft="313.3dp"
                android:layout_marginTop="8.2dp"
                android:scaleType="fitXY" />
        </FrameLayout>

        <View
            android:id="@+id/password_underline"
            android:layout_width="344.7dp"
            android:layout_height="2.0dp"
            android:background="#FF2D55"
            android:layout_gravity="top|start"
            android:layout_marginStart="44.0dp"
            android:layout_marginLeft="44.0dp"
            android:layout_marginTop="369.0dp" />

        <TextView
            android:id="@+id/view_10"
            android:layout_width="201.5dp"
            android:layout_height="17.6dp"
            android:fontFamily="sans-serif"
            android:text="Invalid email and/or password"
            android:textColor="#26241D"
            android:textSize="14.5sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="37.0dp"
            android:layout_marginLeft="37.0dp"
            android:layout_marginTop="382.9dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8.0sp"
            android:autoSizeMaxTextSize="14.5sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />

        <Button
            android:id="@+id/view_11"
            android:layout_width="355.9dp"
            android:layout_height="48.4dp"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="Log in"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17.4sp"
            android:background="@drawable/shape_1"
            android:layout_gravity="top|start"
            android:layout_marginStart="27.6dp"
            android:layout_marginLeft="27.6dp"
            android:layout_marginTop="443.4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9.6sp"
            android:autoSizeMaxTextSize="17.4sp"
            android:autoSizeStepGranularity="1px"
            android:padding="0dp" />

        <TextView
            android:id="@+id/view_12"
            android:layout_width="324.5dp"
            android:layout_height="47.7dp"
            android:fontFamily="sans-serif"
            android:text="Don't have an account yet? Sign up\nhere!"
            android:textColor="#FFFFFF"
            android:textSize="19.3sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="34.8dp"
            android:layout_marginLeft="34.8dp"
            android:layout_marginTop="515.0dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:lineSpacingExtra="-0.6dp"
            android:gravity="top|start" />

        <TextView
            android:id="@+id/view_13"
            android:layout_width="208.7dp"
            android:layout_height="23.7dp"
            android:fontFamily="sans-serif"
            android:text="Forgot your password?"
            android:textColor="#FFFFFF"
            android:textSize="19.5sp"
            android:layout_gravity="top|start"
            android:layout_marginStart="34.8dp"
            android:layout_marginLeft="34.8dp"
            android:layout_marginTop="568.6dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10.7sp"
            android:autoSizeMaxTextSize="19.5sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />

        <FrameLayout
            android:layout_width="416.2dp"
            android:layout_height="35.7dp"
            android:id="@+id/view_14"
            android:layout_gravity="top|start"
            android:layout_marginStart="0.0dp"
            android:layout_marginLeft="0.0dp"
            android:layout_marginTop="618.6dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/view_15"
                android:layout_width="93.5dp"
                android:layout_height="20.6dp"
                android:fontFamily="sans-serif"
                android:text="Powered by"
                android:textColor="#212020"
                android:textSize="16.9sp"
                android:layout_gravity="top|start"
                android:layout_marginStart="258.2dp"
                android:layout_marginLeft="258.2dp"
                android:layout_marginTop="10.5dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9.3sp"
                android:autoSizeMaxTextSize="16.9sp"
                android:autoSizeStepGranularity="1px"
                android:gravity="center_vertical|start" />

            <ImageView
                android:id="@+id/view_16"
                android:layout_width="33.6dp"
                android:layout_height="29.7dp"
                android:contentDescription="@null"
                android:src="@drawable/img_4"
                android:layout_gravity="top|start"
                android:layout_marginStart="348.5dp"
                android:layout_marginLeft="348.5dp"
                android:layout_marginTop="6.0dp"
                android:scaleType="fitXY" />
        </FrameLayout>
    </FrameLayout>

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="26.6dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#3B4147" />

    <View
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="54.9dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="676.6dp"
        android:background="#F5F5F5" />
</FrameLayout>
