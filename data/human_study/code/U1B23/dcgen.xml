<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/img"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="28dp"
    android:id="@+id/view_1"
    android:layout_width="411.4286dp"
    android:layout_height="731.4286dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:text="MEGASTORES\nDEN HAAG"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.95"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Email"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp"
            android:paddingTop="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="dummy_user_input"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:paddingTop="22dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/password_label"
                android:text="Password"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:src="@drawable/img"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:alpha="0.9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </RelativeLayout>

        <TextView
            android:text="Invalid email and/or password"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:paddingTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:text="Log in"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#E5007D"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="26dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Don't have an account yet? Sign up\nhere!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.15"
            android:paddingTop="26dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Forgot your password?"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingTop="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_gravity="bottom|end"
        android:text="Powered by"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:paddingBottom="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</FrameLayout>
