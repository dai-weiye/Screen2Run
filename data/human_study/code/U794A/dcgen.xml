<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp">

    <LinearLayout
        android:orientation="vertical"
        android:background="#000000"
        android:id="@+id/view_2"
        android:layout_width="411.4239dp"
        android:layout_height="333.939dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="#000000">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▦  ▢  ▶  |||"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:23"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/img"
            android:scaleType="centerCrop"
            android:contentDescription="Hero image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="#000000">

            <ImageView
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:src="@drawable/img"
                android:scaleType="fitCenter"
                android:contentDescription="It Works logo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:divider="#00000000"
            android:dividerHeight="8dp"
            android:showDividers="middle"
            android:background="#000000">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="16sp"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="16sp"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:background="#A4C639"
                android:padding="16dp"
                android:textSize="20sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:background="#FFFFFF"
        android:id="@+id/view_3"
        android:layout_width="411.4239dp"
        android:layout_height="26.7426dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="365.8244dp">

        <View
            android:layout_width="143dp"
            android:layout_height="3dp"
            android:layout_gravity="top|start"
            android:background="#000000" />

        <ImageView
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_gravity="top|center_horizontal"
            android:translationY="-31dp"
            android:scaleType="fitXY"
            android:src="@drawable/img" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/view_4"
        android:layout_width="411.4239dp"
        android:layout_height="255.0828dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="403.1954dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="JOIN THE PARTY"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Now on your Android"
                android:textColor="#6E6E6E"
                android:textSize="16sp"
                android:paddingTop="6sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:text="Get Started"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="34dp"
            android:paddingLeft="26dp"
            android:paddingRight="26dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:background="#A5C93E"
            android:elevation="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="v1.1.4"
            android:textColor="#B0FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>
</FrameLayout>
