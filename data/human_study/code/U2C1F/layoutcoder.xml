<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="852">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="92">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/img"
                    android:tint="#B3B3B3"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="509">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1DC7EE">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:src="@drawable/img"
                    android:scaleType="fitXY"
                    android:padding="0dp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="594">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="656">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="251">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#29C5F6">

                        <FrameLayout
                            android:layout_width="165dp"
                            android:layout_height="322dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginStart="90dp"
                            android:layout_marginTop="172dp">

                            <ImageView
                                android:layout_width="97dp"
                                android:layout_height="97dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="45dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:layout_width="97dp"
                                android:layout_height="105dp"
                                android:layout_gravity="top|start"
                                android:layout_marginTop="90dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:layout_width="97dp"
                                android:layout_height="127dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="67dp"
                                android:layout_marginTop="75dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="75dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="22dp"
                                android:layout_marginTop="187dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:layout_width="127dp"
                                android:layout_height="112dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="210dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#FFFFFF" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="330dp"
                            android:layout_height="330dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="-202dp"
                            android:layout_marginTop="480dp">

                            <ImageView
                                android:layout_width="330dp"
                                android:layout_height="330dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#F0952F" />

                            <ImageView
                                android:layout_width="255dp"
                                android:layout_height="255dp"
                                android:layout_gravity="center"
                                android:scaleType="fitXY"
                                android:src="@drawable/img"
                                android:tint="#F4D22E" />
                        </FrameLayout>

                        <ImageView
                            android:layout_width="260dp"
                            android:layout_height="200dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="-60dp"
                            android:layout_marginBottom="-140dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/img"
                            android:tint="#7B1E1E" />

                        <ImageView
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="-45dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/img"
                            android:tint="#EFCDA6" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="343">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="186">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#3EC8E8">

                            <View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="34dp"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="44dp"
                                android:background="#FCF5EB" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="46dp"
                                android:rotation="90"
                                android:fontFamily="sans-serif-medium"
                                android:text="T-Shirts"
                                android:textColor="#3A3A3A"
                                android:textSize="19sp" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="30dp"
                                android:layout_marginTop="0dp"
                                android:layout_marginEnd="0dp"
                                android:layout_marginBottom="128dp"
                                android:rotation="-8"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="86dp"
                                android:layout_marginTop="62dp"
                                android:layout_marginEnd="0dp"
                                android:layout_marginBottom="74dp"
                                android:rotation="-4"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="126dp"
                                android:layout_marginEnd="52dp"
                                android:layout_marginBottom="0dp"
                                android:rotation="10"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img" />
                        </FrameLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="137">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#3FD3F2">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="start|center_vertical"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="191">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#29C6E8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="58"
                            android:background="#7A2B1E" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="42" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="40"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="8" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="92"
                                android:background="#F0C88C" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="60" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="24dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/img"
                            android:tint="#FFFFFF" />

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:background="#7A2B1E" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="46" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="14dp"
                            android:src="@drawable/img"
                            android:tint="#F5A130" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="54" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="519">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="92">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="36dp"
                    android:src="@drawable/img"
                    android:tint="#9E9E9E" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/img"
                    android:tint="#9E9E9E" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1103">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#29D2F2">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/img"
                    android:scaleType="centerCrop" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="544">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="92">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1103">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00BFFF">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img"
                    android:tint="#333333"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|center_vertical"
                    android:rotation="90"
                    android:text="for parents"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:layout_marginRight="10dp"
                    android:translationX="55dp" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
