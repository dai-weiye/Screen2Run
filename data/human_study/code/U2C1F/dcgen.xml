<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp">

    <FrameLayout
        android:background="#FF29C8F0"
        android:id="@+id/view_2"
        android:layout_width="300.3394dp"
        android:layout_height="658.2782dp"
        android:layout_marginStart="111.0844dp"
        android:layout_marginTop="0dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitXY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerInside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="T-Shirts"
            android:textColor="#FF1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:rotation="90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="for parents"
            android:textColor="#FF14304A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:rotation="90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="centerInside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="69.9421dp"
        android:layout_height="658.2782dp"
        android:id="@+id/view_3"
        android:layout_marginStart="33.2568dp"
        android:layout_marginTop="0dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitXY"
            android:id="@+id/view_4"
            android:layout_width="69.9421dp"
            android:layout_height="337.3676dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp" />

        <FrameLayout
            android:background="#1FC9F1"
            android:id="@+id/view_5"
            android:layout_width="69.9421dp"
            android:layout_height="315.7678dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="342.5104dp">

            <ImageView
                android:src="@drawable/img"
                android:scaleType="fitXY"
                android:layout_gravity="top"
                android:contentDescription=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:orientation="vertical"
        android:background="#000000"
        android:gravity="center"
        android:padding="8dp"
        android:id="@+id/view_6"
        android:layout_width="33.2568dp"
        android:layout_height="658.2782dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:tint="#E8E8E8"
            android:contentDescription=""
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:tint="#E8E8E8"
            android:contentDescription=""
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:tint="#E8E8E8"
            android:contentDescription=""
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
