<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004450"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="658.3dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/view_3"
            android:layout_width="34.1dp"
            android:layout_height="662.1dp"
            android:minHeight="75dp"
            android:background="@drawable/shape_2"
            android:layout_gravity="top|start"
            android:layout_marginStart="347.9dp"
            android:layout_marginLeft="347.9dp"
            android:layout_marginTop="-89.5dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="211.8dp"
                android:layout_height="561.7dp"
                android:id="@+id/view_4"
                android:layout_gravity="top|start"
                android:layout_marginStart="-1.0dp"
                android:layout_marginLeft="-1.0dp"
                android:layout_marginTop="28.4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/view_5"
                    android:layout_width="17.0dp"
                    android:layout_height="102.6dp"
                    android:src="@drawable/img_1"
                    android:contentDescription="Network error"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16.6dp"
                    android:layout_marginLeft="16.6dp"
                    android:layout_marginTop="84.4dp"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/view_6"
                    android:layout_width="16.1dp"
                    android:layout_height="500.6dp"
                    android:src="@drawable/img_2"
                    android:contentDescription="No Internet connection - Please check your network settings (cellphone network)"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="0.0dp"
                    android:layout_marginLeft="0.0dp"
                    android:layout_marginTop="61.1dp"
                    android:scaleType="fitXY" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/view_7"
            android:layout_width="226.3dp"
            android:layout_height="398.6dp"
            android:background="@drawable/img_3"
            android:layout_gravity="top|start"
            android:layout_marginStart="124.8dp"
            android:layout_marginLeft="124.8dp"
            android:layout_marginTop="124.0dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/view_8"
                android:layout_width="50.2dp"
                android:layout_height="529.9dp"
                android:background="@drawable/shape_3"
                android:layout_gravity="top|start"
                android:layout_marginStart="88.0dp"
                android:layout_marginLeft="88.0dp"
                android:layout_marginTop="-65.7dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/view_9"
                    android:layout_width="20.4dp"
                    android:layout_height="147.7dp"
                    android:src="@drawable/img_4"
                    android:contentDescription="Truck Parking USA"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="29.0dp"
                    android:layout_marginLeft="29.0dp"
                    android:layout_marginTop="84.0dp"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/view_10"
                    android:layout_width="19.2dp"
                    android:layout_height="421.7dp"
                    android:src="@drawable/img_5"
                    android:contentDescription="We are sorry but it appears that there is a problem with the app. Bug report was automatically sent to PTV Truck Europe."
                    android:layout_gravity="top|start"
                    android:layout_marginStart="-0.3dp"
                    android:layout_marginLeft="-0.3dp"
                    android:layout_marginTop="54.4dp"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <ImageView
                android:id="@+id/view_11"
                android:src="@drawable/img_6"
                android:contentDescription="report was automatically sent to PTV Truck Europe."
                android:layout_width="13.6dp"
                android:layout_height="315.6dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="74.1dp"
                android:layout_marginLeft="74.1dp"
                android:layout_marginTop="2.3dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/view_12"
                android:text="OК"
                android:textColor="#00ACCD"
                android:layout_width="24.9dp"
                android:layout_height="20.0dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="40.3dp"
                android:layout_marginLeft="40.3dp"
                android:layout_marginTop="41.0dp"
                android:textSize="16.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9.1sp"
                android:autoSizeMaxTextSize="16.5sp"
                android:autoSizeStepGranularity="1px"
                android:gravity="center_vertical|start" />
        </FrameLayout>

        <ImageView
            android:id="@+id/view_13"
            android:src="@drawable/img_7"
            android:contentDescription="9 = Z 8:20"
            android:layout_width="14.6dp"
            android:layout_height="75.6dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="395.1dp"
            android:layout_marginLeft="395.1dp"
            android:layout_marginTop="582.7dp"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/view_14"
            android:src="@drawable/img_8"
            android:layout_width="11.7dp"
            android:layout_height="22.6dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9.3dp"
            android:layout_marginLeft="9.3dp"
            android:layout_marginTop="206.7dp"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/view_15"
            android:src="@drawable/img_9"
            android:layout_width="13.0dp"
            android:layout_height="24.7dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9.3dp"
            android:layout_marginLeft="9.3dp"
            android:layout_marginTop="316.8dp"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/view_16"
            android:src="@drawable/img_10"
            android:layout_width="11.7dp"
            android:layout_height="23.3dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9.3dp"
            android:layout_marginLeft="9.3dp"
            android:layout_marginTop="429.3dp"
            android:scaleType="fitXY" />
    </FrameLayout>

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="25.0dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#004552" />
</FrameLayout>
