<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="411.4239dp"
    android:layout_height="658.2782dp"
    android:id="@+id/view_1">

    <FrameLayout
        android:layout_width="411.4239dp"
        android:layout_height="25.714dp"
        android:id="@+id/view_2"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <View
            android:background="#D9A892"
            android:id="@+id/view_3"
            android:layout_width="26.0568dp"
            android:layout_height="25.714dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp" />

        <View
            android:background="#D2A79B"
            android:id="@+id/view_4"
            android:layout_width="359.9959dp"
            android:layout_height="25.714dp"
            android:layout_marginStart="51.428dp"
            android:layout_marginTop="0dp" />
    </FrameLayout>

    <FrameLayout
        android:background="@drawable/img"
        android:paddingTop="40dp"
        android:id="@+id/view_5"
        android:layout_width="411.4239dp"
        android:layout_height="392.9098dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="60.685dp">

        <LinearLayout
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/img"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="livestream"
                    android:textColor="#FFFFFFFF"
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:text="Watch or Broadcast\nLive Events"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:fontFamily="sans-serif-light"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:id="@+id/view_6"
        android:layout_width="411.4239dp"
        android:layout_height="171.4266dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="453.5948dp">

        <Button
            android:id="@+id/continue_facebook_button"
            android:text="CONTINUE WITH FACEBOOK"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:gravity="center"
            android:backgroundTint="#4C8BF5"
            android:drawableStart="@drawable/img"
            android:drawablePadding="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:minHeight="60dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/continue_email_button"
            android:text="CONTINUE WITH EMAIL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:gravity="center"
            android:backgroundTint="#33FFFFFF"
            android:drawableStart="@drawable/img"
            android:drawablePadding="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:minHeight="60dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/permission_note"
            android:text="We'll never post without your permission"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#000000"
        android:id="@+id/view_7"
        android:layout_width="411.4239dp"
        android:layout_height="33.2568dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="625.0214dp">

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:src="@drawable/img"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
