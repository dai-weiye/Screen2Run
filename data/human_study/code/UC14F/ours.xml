<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/view_2"
        android:layout_width="411.4dp"
        android:layout_height="87.3dp"
        android:background="@drawable/shape_1"
        android:layout_gravity="top|start"
        android:layout_marginStart="0.0dp"
        android:layout_marginLeft="0.0dp"
        android:layout_marginTop="0.0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/view_3"
            android:layout_width="117.9dp"
            android:layout_height="26.1dp"
            android:text="android_gui"
            android:textColor="#FFFFFF"
            android:textSize="21.2sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:layout_gravity="top|start"
            android:layout_marginStart="16.3dp"
            android:layout_marginLeft="16.3dp"
            android:layout_marginTop="44.0dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11.7sp"
            android:autoSizeMaxTextSize="21.2sp"
            android:autoSizeStepGranularity="1px"
            android:gravity="center_vertical|start" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/view_4"
        android:layout_width="411.4dp"
        android:layout_height="523.3dp"
        android:background="@drawable/shape_2"
        android:layout_gravity="top|start"
        android:layout_marginStart="-11.9dp"
        android:layout_marginLeft="-11.9dp"
        android:layout_marginTop="84.2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/view_5"
            android:layout_width="411.4dp"
            android:layout_height="35.4dp"
            android:background="@drawable/shape_2"
            android:layout_gravity="top|start"
            android:layout_marginStart="0.0dp"
            android:layout_marginLeft="0.0dp"
            android:layout_marginTop="22.0dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <RadioButton
                android:id="@+id/view_6"
                android:layout_width="32.0dp"
                android:layout_height="31.3dp"
                android:checked="false"
                android:enabled="true"
                android:buttonTint="#000000"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="13.2dp"
                android:layout_marginLeft="13.2dp"
                android:layout_marginTop="3.9dp" />

            <TextView
                android:id="@+id/view_7"
                android:layout_width="48.8dp"
                android:layout_height="18.0dp"
                android:text="Fphom"
                android:textColor="#000000"
                android:textSize="14.4sp"
                android:fontFamily="sans-serif"
                android:textAlignment="viewStart"
                android:layout_gravity="top|start"
                android:layout_marginStart="56.7dp"
                android:layout_marginLeft="56.7dp"
                android:layout_marginTop="10.8dp"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7.9sp"
                android:autoSizeMaxTextSize="14.4sp"
                android:autoSizeStepGranularity="1px"
                android:gravity="center_vertical|start" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/view_8"
        android:layout_width="411.4dp"
        android:layout_height="32.4dp"
        android:background="@drawable/shape_2"
        android:layout_gravity="top|start"
        android:layout_marginStart="-11.9dp"
        android:layout_marginLeft="-11.9dp"
        android:layout_marginTop="607.5dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/view_9"
            android:layout_width="20.2dp"
            android:layout_height="17.2dp"
            android:src="@drawable/img_1"
            android:contentDescription="@null"
            android:layout_gravity="top|start"
            android:layout_marginStart="195.4dp"
            android:layout_marginLeft="195.4dp"
            android:layout_marginTop="9.3dp"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/view_10"
            android:layout_width="19.1dp"
            android:layout_height="19.1dp"
            android:src="@drawable/img_2"
            android:contentDescription="@null"
            android:layout_gravity="top|start"
            android:layout_marginStart="368.4dp"
            android:layout_marginLeft="368.4dp"
            android:layout_marginTop="8.5dp"
            android:scaleType="fitXY" />
    </FrameLayout>

    <View
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="26.9dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0.0dp"
        android:background="#303F9F" />
</FrameLayout>
