                    android:src="@drawable/img"
                    android:tint="#FFFFFF" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="7:00"
