                android:orientation="horizontal"
                android:paddingRight="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img"
                    android:tint="#FFFFFF" />

                <Space
                    android:layout_width="4dp"
